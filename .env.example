# Copy this file to ".env" for local development:   cp .env.example .env
# NEVER commit your real ".env" file (it is listed in .gitignore).

# Use "development" locally so the contact form works without email set up.
# Leave unset (or "production") on Render.
APP_ENV=development

# Set to 1 only on your own computer to get Flask's debug page. Never on Render.
FLASK_DEBUG=0

# Long random text. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Your site's public address (used for canonical links, sitemap, social previews).
SITE_URL=https://alaganesh-portfolio.onrender.com

# Optional overrides for the links shown on the site.
# LINKEDIN_URL=https://www.linkedin.com/in/your-profile
# PUBLIC_CONTACT_EMAIL=you@example.com

# ---- Contact form email (choose ONE method) -------------------------------
# Where messages are delivered:
CONTACT_TO_EMAIL=

# Method 1 (recommended on Render free plan): Resend HTTPS API
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Method 2: SMTP (works locally and on paid Render plans; blocked on the free plan)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
